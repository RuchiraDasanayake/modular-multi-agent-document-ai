{
  "metadata": {
    "name": "AHMN Policy Selection Benchmark",
    "description": "Ground-truth (document context → expected policy) mappings used to evaluate the Adaptive Hierarchical Memory Network's routing accuracy. Tests cover three regimes: (1) seen contexts that match LTM seeds verbatim, (2) unseen contexts that share semantic similarity with seeds (RABI generalisation test), and (3) cold-start unknown contexts.",
    "total_cases": 30,
    "regimes": {
      "seen": "Document context exactly matches an LTM seed → expect the seeded policy with high confidence",
      "near_neighbor": "Document context not in LTM but semantically similar to a seed → tests RABI's k-NN generalisation in vector space",
      "cold_start": "Document context with no semantic neighbour in LTM → tests safe fallback to the default policy"
    },
    "policies": ["table_heavy", "forms", "scanned_text", "mixed_content", "default"],
    "scoring": {
      "policy_match": "Selected policy_id equals expected_policy_id",
      "rabi_used": "rabi_used=true expected for seen and near_neighbor regimes",
      "confidence_calibrated": "Confidence ≥ 0.6 for seen, ≥ 0.4 for near_neighbor, ≤ 0.5 for cold_start"
    },
    "author": "Pathirana M.M. and team",
    "version": "1.0"
  },
  "cases": [
    {
      "id": "c01",
      "regime": "seen",
      "doc_type": "invoice",
      "vendor": "acme_corp",
      "content_profile": "table-heavy",
      "expected_policy": "table_heavy",
      "min_confidence": 0.6,
      "expect_rabi": true,
      "rationale": "Exact LTM seed match for invoice + table-heavy"
    },
