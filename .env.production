# Production Environment Configuration
# Change ALL values before deploying to production!

# ═════════════════════════════════════════════════════════════════
# SECURITY: CHANGE ALL DEFAULT VALUES
# ═════════════════════════════════════════════════════════════════

# ── Database (PostgreSQL) ──
POSTGRES_USER=produser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE_32_CHARS
POSTGRES_DB=ahmn_production
POSTGRES_PORT=5432
POSTGRES_URI=postgresql://produser:CHANGE_ME_STRONG_PASSWORD_HERE_32_CHARS@db:5432/ahmn_production

# ── Redis Cache ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_32_CHARS

# ── JWT Authentication ──
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_64_CHARS_GENERATED_ABOVE
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Service URLs (Docker internal network) ──
AHMN_SERVICE_URL=http://ahmn:8001
GUARDRAILS_SERVICE_URL=http://guardrails:8002
XAI_HITL_SERVICE_URL=http://xai-hitl:8003
IDPO_SERVICE_URL=http://idpo:8004

# ── Frontend Configuration ──
# Replace with your actual VPS domain or IP
NEXT_PUBLIC_API_URL=http://YOUR_VPS_IP_OR_DOMAIN:8000
NEXT_PUBLIC_API_URL=https://api.yourdomain.com  # Use HTTPS in production

# ── Gateway Configuration ──
GATEWAY_PORT=8000
FRONTEND_PORT=3000

# ── API Keys (Optional - for cloud fallbacks) ──
# OPENAI_API_KEY=sk-... (if using OpenAI)
# ANTHROPIC_API_KEY=... (if using Anthropic)

# ── Logging ──
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Advanced (Leave as-is unless you know what you're doing) ──
AHMN_SEED_MODE=random
ENVIRONMENT=production
DEBUG=false
