# ═══════════════════════════════════════════════════════════════
# IDPO — Environment Variables
# Copy to .env and fill in values
# ═══════════════════════════════════════════════════════════════

# ── LLM / OpenAI ──
OPENAI_API_KEY=sk-your-key-here
OPENAI_API_URL=https://api.openai.com/v1

# ── LLM / Ollama (local) ──
OLLAMA_BASE_URL=http://localhost:11434

# ── LLM / Anthropic (optional) ──
ANTHROPIC_API_KEY=

# ── Pipeline defaults ──
IDPO_CONFIG_PATH=configs/sample_config.json
IDPO_POLICY_STORE_PATH=configs/policy_store.json
IDPO_INPUT_DIR=inputs/processed
IDPO_RUN_DIR=runs
