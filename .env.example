# ═══════════════════════════════════════════════════════════════
# Modular Multi-Agent Document AI — Environment Configuration
# Copy to .env and update values for your environment.
# ═══════════════════════════════════════════════════════════════

# ── PostgreSQL ──
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=ahmn_db
POSTGRES_PORT=5432
POSTGRES_URI=postgresql://user:password@db:5432/ahmn_db

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ── JWT Auth ──
JWT_SECRET_KEY=change-me-in-production-use-a-32-char-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Service URLs (internal Docker network) ──
AHMN_SERVICE_URL=http://ahmn:8001
GUARDRAILS_SERVICE_URL=http://guardrails:8002
XAI_HITL_SERVICE_URL=http://xai-hitl:8003

# ── CORS ──
BACKEND_CORS_ORIGINS=http://localhost:3000

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Guardrails ──
THRESHOLD_FAITHFULNESS=0.78

# ── Logging ──
LOG_LEVEL=INFO

# ═══════════════════════════════════════════════════════════════
# IDPO — Additional Environment Variables
# ═══════════════════════════════════════════════════════════════

# ── LLM / OpenAI ──
OPENAI_API_KEY=sk-your-key-here
OPENAI_API_URL=https://api.openai.com/v1

# ── LLM / Ollama (local) ──
OLLAMA_BASE_URL=http://localhost:11434

# ── LLM / Anthropic (optional) ──
ANTHROPIC_API_KEY=

# ── Pipeline defaults ──
IDPO_CONFIG_PATH=configs/sample_config.json
IDPO_POLICY_STORE_PATH=configs/policy_store.json
IDPO_INPUT_DIR=inputs/processed
IDPO_RUN_DIR=runs
