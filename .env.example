# ═══════════════════════════════════════════════════════════════
# Modular Multi-Agent Document AI — Environment Configuration
# Copy to .env and update values for your environment.
# ═══════════════════════════════════════════════════════════════

# ── PostgreSQL ──
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=ahmn_db
POSTGRES_PORT=5432
POSTGRES_URI=postgresql://user:password@db:5432/ahmn_db

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=docai_redis_secret

# ── JWT Auth ──
# IMPORTANT: Change this to a strong random secret in production!
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-production-use-a-32-char-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── First admin account ──
# The gateway creates this admin at startup while the database has no admin.
# It never changes an existing account; change the password in the app afterwards.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=

# ── Public sign-up ──
# Keep this off until per-user processing and storage quotas exist.
# Admins can add viewer accounts on the Admin page. Enable public sign-up explicitly only
# for a controlled deployment with abuse and resource limits.
# PUBLIC_SIGNUP_ENABLED=true

# ── Service URLs (internal Docker network) ──
AHMN_SERVICE_URL=http://ahmn:8001
GUARDRAILS_SERVICE_URL=http://guardrails:8002
XAI_HITL_SERVICE_URL=http://xai-hitl:8003
IDPO_SERVICE_URL=http://idpo:8004

# ── CORS ──
BACKEND_CORS_ORIGINS=http://localhost:3000

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Guardrails ──
THRESHOLD_FAITHFULNESS=0.78

# ── Logging ──
LOG_LEVEL=INFO

# ═══════════════════════════════════════════════════════════════
# IDPO — Additional Environment Variables
# ═══════════════════════════════════════════════════════════════

# ── LLM / OpenAI ──
# Paste your real OpenAI key here to enable LLM extraction.
# Without a valid key, the pipeline uses heuristic-only extraction.
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1

# ── LLM / Ollama (local) ──
OLLAMA_BASE_URL=http://localhost:11434

# ── LLM / Anthropic (optional) ──
ANTHROPIC_API_KEY=

# ── Pipeline defaults ──
IDPO_CONFIG_PATH=configs/config.json
IDPO_POLICY_STORE_PATH=configs/policy_store.json
IDPO_DATA_DIR=../idpo-data
IDPO_HOST_DATA_DIR=../idpo-data
