{
  "workspaceRoot": "..",
  "runsDir": "../runs",
  "uploadsDir": "./data/uploads",
  "jobsDir": "./data/jobs",
  "demoSampleRunsDir": "./demo_sample_runs",
  "maxUploadMb": 25,
  "allowedExtensions": [
    ".pdf",
    ".png",
    ".jpg",
    ".jpeg",
    ".txt",
    ".json"
  ],
  "defaultCommandId": "idpo_demo",
  "commands": [
    {
      "id": "idpo_demo",
      "description": "Run IDPO demo pipeline",
      "program": "python",
      "args": [
        "-m",
        "idpo.demo",
        "--input",
        "{input_dir}",
        "--config",
        "{config_path}"
      ],
      "cwd": "..",
      "env": {
        "PYTHONUTF8": "1"
      }
    }
  ],
  "backendChecks": [
    {
      "id": "idpo-cli",
      "kind": "cli",
      "command": "python",
      "args": [
        "-m",
        "idpo.demo",
        "--help"
      ]
    },
    {
      "id": "ahmn-api",
      "kind": "http",
      "url": "http://localhost:8000/api/health",
      "timeoutMs": 2000
    },
    {
      "id": "xai-hitl-api",
      "kind": "http",
      "url": "http://localhost:8000/api/xai/health",
      "timeoutMs": 2000
    },
    {
      "id": "guardrails-api",
      "kind": "http",
      "url": "http://localhost:8000/api/guardrails/health",
      "timeoutMs": 2000
    }
  ]
}
