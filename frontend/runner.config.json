{
  "workspaceRoot": "..",
  "runsDir": "../../idpo-data/runs",
  "uploadsDir": "../../idpo-data/frontend/uploads",
  "jobsDir": "../../idpo-data/frontend/jobs",
  "demoSampleRunsDir": "./demo_sample_runs",
  "maxUploadMb": 25,
  "allowedExtensions": [
    ".pdf",
    ".png",
    ".jpg",
    ".jpeg",
    ".txt",
    ".json"
  ],
  "defaultCommandId": "idpo_process_inbox",
  "commands": [
    {
      "id": "idpo_process_inbox",
      "description": "Run IDPO inbox pipeline over uploaded files",
      "program": "python",
      "args": [
        "-m",
        "idpo.cli",
        "process-inbox",
        "--root",
        "{workspace_root}",
        "--config",
        "{config_path}",
        "--input-dir",
        "{input_dir}"
      ],
      "cwd": "..",
      "env": {
        "PYTHONUTF8": "1"
      }
    }
  ],
  "backendChecks": [
    {
      "id": "idpo-cli",
      "kind": "cli",
      "command": "python",
      "args": [
        "-m",
        "idpo.cli",
        "--help"
      ]
    },
    {
      "id": "gateway",
      "kind": "http",
      "url": "http://127.0.0.1:8000/health",
      "timeoutMs": 3000
    },
    {
      "id": "ahmn",
      "kind": "http",
      "url": "http://127.0.0.1:8001/health",
      "timeoutMs": 3000
    },
    {
      "id": "guardrails",
      "kind": "http",
      "url": "http://127.0.0.1:8002/health",
      "timeoutMs": 3000
    },
    {
      "id": "xai-hitl",
      "kind": "http",
      "url": "http://127.0.0.1:8003/health",
      "timeoutMs": 3000
    },
    {
      "id": "idpo-ui",
      "kind": "http",
      "url": "http://127.0.0.1:8004/health",
      "timeoutMs": 3000
    }
  ]
}
