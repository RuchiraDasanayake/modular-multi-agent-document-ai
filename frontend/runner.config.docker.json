{
  "workspaceRoot": ".",
  "runsDir": "/idpo-data/runs",
  "uploadsDir": "/idpo-data/frontend/uploads",
  "jobsDir": "/idpo-data/frontend/jobs",
  "demoSampleRunsDir": "./demo_sample_runs",
  "maxUploadMb": 25,
  "allowedExtensions": [
    ".pdf",
    ".png",
    ".jpg",
    ".jpeg",
    ".tif",
    ".tiff",
    ".bmp",
    ".txt",
    ".json"
  ],
  "defaultCommandId": "idpo_process_inbox",
  "canonicalRunnerAvailable": false,
  "commands": [
    {
      "id": "idpo_process_inbox",
      "description": "Research runner unavailable in Docker; use the single-host research setup",
      "program": "node",
      "args": ["/app/scripts/product-worker-client.mjs", "--unsupported-research-runner"],
      "cwd": ".",
      "env": {}
    },
    {
      "id": "idpo_process_auto",
      "description": "Run source-grounded automatic extraction in the private product worker",
      "program": "node",
      "args": ["/app/scripts/product-worker-client.mjs", "--input", "{input_dir}", "--run-id", "{run_id}"],
      "cwd": ".",
      "env": {}
    }
  ],
  "backendChecks": [
    {
      "id": "product-worker",
      "kind": "cli",
      "command": "node",
      "args": ["/app/scripts/product-worker-client.mjs", "--health"]
    }
  ]
}
