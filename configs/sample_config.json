{
  "structuring": {
    "allow_generic_kv": true,
    "heading_max_words": 6,
    "extraction_rules": [
      {
        "key": "record_id",
        "label": "Record ID",
        "pattern": "Record\\s*ID[:\\s]+([A-Z0-9-]+)"
      },
      {
        "key": "document_date",
        "label": "Document Date",
        "pattern": "Date[:\\s]+([0-9/-]+)"
      },
      {
        "key": "total_amount",
        "label": "Total Amount",
        "pattern": "Total\\s*Amount[:\\s]+\\$?([0-9,.]+)"
      }
    ]
  },
  "preprocessing": {
    "ocr_engine": "tesseract",
    "ocr_version": "v1",
    "ocr_lang": "eng",
    "ocr_psm": 6,
    "ocr_oem": 3,
    "ocr_dpi": 300,
    "ocr_alt_psm": [
      4,
      11
    ],
    "ocr_passes": 2,
    "deskew": true,
    "denoise": true,
    "table_mode": "heuristic",
    "max_retries": 2
  },
  "validation": {
    "min_confidence": 0.6,
    "max_field_errors": 3,
    "rules": [
      {
        "field_pattern": ".*_id$",
        "value_pattern": "^[A-Z0-9-]+$",
        "severity": "high",
        "normalize": "strip"
      },
      {
        "field_pattern": ".*_amount$",
        "value_pattern": "^\\d+(\\.\\d{2})?$",
        "severity": "medium",
        "normalize": "numeric"
      },
      {
        "field_pattern": ".*_date$",
        "value_pattern": "^\\d{1,2}[/-]\\d{1,2}[/-]\\d{2,4}$",
        "severity": "medium",
        "normalize": "strip"
      }
    ]
  },
  "routing": {
    "quality_threshold": 0.6,
    "complexity_threshold": 0.5,
    "retry_threshold": 0.55
  },
  "plan": {
    "default_step_timeout_ms": 30000,
    "default_step_budget_units": 1.0,
    "max_total_budget_units": 6.0
  },
  "shadow": {
    "enabled": false,
    "sample_rate": 0.0,
    "candidate_policy_ids": [],
    "max_policies_per_doc": 1
  },
  "rollback": {
    "enabled": true,
    "window_size": 25,
    "latency_p95_ms": 2500.0,
    "validation_failure_rate": 0.2,
    "quality_drop_threshold": 0.05
  },
  "queue": {
    "enabled": false,
    "max_workers": 4,
    "per_partition_concurrency": 1,
    "partition_keys": [
      "doc_type",
      "vendor_cluster"
    ]
  },
  "ahmn": {
    "enabled": false,
    "mode": "mock",
    "objective": "min_cost",
    "timeout_ms": 500,
    "policy_override_id": null,
    "action_overrides": {}
  },
  "calibration": {
    "enabled": false,
    "method": "heuristic",
    "version": "v1",
    "temperature": 1.0,
    "parameters": {}
  },
  "answering": {
    "min_confidence": 0.55
  },
  "knowledge": {
    "policy_store_path": "configs/policy_store.json",
    "default_policy_id": "default"
  },
  "llm": {
    "local_model": "phi3:mini",
    "cloud_model": "gpt-4o",
    "default_mode": "cloud",
    "history_mode": "cloud",
    "provider": "ollama",
    "cloud_provider": "openai",
    "base_url": "http://localhost:11434",
    "timeout_s": 60,
    "cloud_timeout_s": 60,
    "cloud_temperature": 0.1,
    "cloud_max_tokens": 2000,
    "allow_cloud_fallback": true,
    "openai_api_url": "https://api.openai.com/v1",
    "openai_api_key": "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",
    "use_extraction": true,
    "use_summarization": false
  }
}
