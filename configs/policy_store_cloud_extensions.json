  "policies": [
    {
      "policy_id": "table_heavy_cloud",
      "name": "Table Heavy Cloud Policy",
      "conditions": {
        "content_profile": [
          "table-heavy"
        ],
        "route_bin": [
          "standard",
          "heavy"
        ]
      },
      "actions": {
        "preprocess": {
          "ocr": {
            "enabled": true,
            "passes": 2,
            "psm": 6,
            "alt_psm": [
              4,
              11
            ]
          },
          "deskew": {
            "enabled": true
          },
          "denoise": {
            "enabled": true,
            "strength": "aggressive"
          },
          "table_extract": {
            "enabled": true,
            "type": "heuristic"
          }
        },
        "extraction": {
          "explicit_entities": [
            "invoice_number",
            "supplier_name",
            "total_amount",
            "subtotal",
            "tax",
            "due_date"
          ],
          "model_tier": "cloud",
          "ruleset": "research_table_cloud"
        },
        "recovery": {
          "strategy": "alternate_rules"
        },
        "chunking": {
          "chunk_size": 260,
          "chunk_overlap": 40,
          "max_chunks": 160
        },
        "retrieval": {
          "dense_k": 12,
          "sparse_k": 16,
          "final_k": 12,
          "mmr_lambda": 0.8,
          "metadata_boost": 0.2
        },
        "token_budget": {
          "max_tokens": 1800,
          "reserved_tokens": 240,
          "strategy": "simple"
        },
        "escalation": {
          "tier": "tier2"
        }
      },
      "metadata": {
        "owner": "idpo-research",
        "regime": "table_precision",
        "family": "table extraction",
        "variant": "cloud-extension",
        "base_policy_id": "table_heavy",
        "when_used": "Optional paid extension for dense or ambiguous table-heavy contexts after local policies underperform.",
        "why": "Keeps the same table strategy but swaps in a stronger cloud model when the operator enables paid inference.",
        "tradeoff": "Higher cost and latency, justified only when local reviewed outcomes stay weak.",
        "cost_profile": "high cost optional extension"
      }
    },
