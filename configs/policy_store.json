{
  "default_policy_id": "default",
  "policies": [
    {
      "policy_id": "forms",
      "name": "Form Extraction Policy",
      "conditions": {
        "content_profile": ["form-centric"],
        "doc_type": ["form_document"]
      },
      "actions": {
        "preprocess": {
          "ocr": {
            "enabled": true, "engine": "tesseract", "passes": 2,
            "lang": "eng", "psm": 6, "oem": 3, "dpi": 300, "alt_psm": [4, 11]
          },
          "deskew": { "enabled": true },
          "denoise": { "enabled": true },
          "table_extract": { "enabled": true, "type": "heuristic" }
        },
        "extraction": {
          "explicit_entities": ["record_id", "document_date", "total_amount", "customer_name"],
          "model_tier": "cloud"
        },
        "recovery": { "strategy": "alternate_rules" },
        "chunking": { "chunk_size": 350, "chunk_overlap": 60, "max_chunks": 128 },
        "retrieval": { "dense_k": 12, "sparse_k": 12, "final_k": 12, "mmr_lambda": 0.7, "metadata_boost": 0.15 },
        "token_budget": { "max_tokens": 1600, "reserved_tokens": 200, "strategy": "simple" }
      },
      "metadata": { "owner": "policy-team" }
    },
    {
      "policy_id": "scanned_text",
      "name": "Scanned Text Document Policy",
      "conditions": {
        "content_profile": ["text-heavy", "narrative"],
        "doc_type": ["scanned_document", "report", "article", "letter"]
      },
      "actions": {
        "preprocess": {
          "ocr": {
            "enabled": true, "engine": "tesseract", "passes": 1,
            "lang": "eng", "psm": 3, "oem": 3, "dpi": 300, "alt_psm": []
          },
          "deskew": { "enabled": true },
          "denoise": { "enabled": true },
          "table_extract": { "enabled": false, "type": "heuristic" }
        },
        "extraction": {
          "explicit_entities": ["title", "author", "date", "summary"],
          "model_tier": "cloud"
        },
        "recovery": { "strategy": "regex" },
        "chunking": { "chunk_size": 500, "chunk_overlap": 80, "max_chunks": 128 },
        "retrieval": { "dense_k": 15, "sparse_k": 10, "final_k": 12, "mmr_lambda": 0.6, "metadata_boost": 0.1 },
        "token_budget": { "max_tokens": 2000, "reserved_tokens": 200, "strategy": "simple" }
      },
      "metadata": { "owner": "policy-team" }
    },
    {
      "policy_id": "table_heavy",
      "name": "Table-Heavy Document Policy",
      "conditions": {
        "content_profile": ["tabular", "table-centric", "table-heavy", "spreadsheet"],
        "doc_type": ["invoice", "financial_statement", "ledger", "receipt", "table_document"]
      },
      "actions": {
        "preprocess": {
          "ocr": {
            "enabled": true, "engine": "tesseract", "passes": 2,
            "lang": "eng", "psm": 6, "oem": 3, "dpi": 300, "alt_psm": [4]
          },
          "deskew": { "enabled": true },
          "denoise": { "enabled": true },
          "table_extract": { "enabled": true, "type": "heuristic" }
        },
        "extraction": {
          "explicit_entities": ["total_amount", "subtotal", "tax", "date", "invoice_number", "vendor_name"],
          "model_tier": "cloud"
        },
        "recovery": { "strategy": "alternate_rules" },
        "chunking": { "chunk_size": 300, "chunk_overlap": 50, "max_chunks": 200 },
        "retrieval": { "dense_k": 10, "sparse_k": 15, "final_k": 12, "mmr_lambda": 0.8, "metadata_boost": 0.2 },
        "token_budget": { "max_tokens": 1800, "reserved_tokens": 200, "strategy": "simple" }
      },
      "metadata": { "owner": "policy-team" }
    },
    {
      "policy_id": "mixed_content",
      "name": "Mixed Content Document Policy",
