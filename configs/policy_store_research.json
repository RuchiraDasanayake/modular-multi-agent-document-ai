{
  "default_policy_id": "default",
  "policies": [
    {
      "policy_id": "table_heavy",
      "name": "Table Heavy Policy",
      "conditions": {
        "content_profile": [
          "table-heavy"
        ],
        "route_bin": [
          "standard",
          "heavy"
        ]
      },
      "actions": {
        "preprocess": {
          "ocr": {
            "enabled": true,
            "passes": 2
          },
          "deskew": {
            "enabled": true
          },
          "denoise": {
            "enabled": true,
            "strength": "aggressive"
          },
          "table_extract": {
            "enabled": true,
            "type": "heuristic"
          }
        },
        "extraction": {
          "explicit_entities": [
            "statement_id",
            "date",
            "total_amount"
          ],
          "model_tier": "local"
        },
        "recovery": {
          "strategy": "alternate_rules"
        },
        "chunking": {
          "chunk_size": 260,
          "chunk_overlap": 40,
          "max_chunks": 160
        }
      },
      "metadata": {
        "owner": "idpo-research"
      }
    },
    {
