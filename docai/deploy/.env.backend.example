# Required persistent paths
DOCAI_RUNS_DIR=/var/lib/docai/runs
DOCAI_SQLITE_PATH=/var/lib/docai/db/docai.sqlite

# Set to deployed frontend origin(s), comma-separated
DOCAI_CORS_ALLOW_ORIGINS=https://your-frontend.example.com

# Optional model provider settings
DOCAI_MODEL_PROVIDER=stub
DOCAI_OLLAMA_BASE_URL=http://127.0.0.1:11434
DOCAI_OLLAMA_MODEL=qwen
DOCAI_OLLAMA_TIMEOUT_SECONDS=60
