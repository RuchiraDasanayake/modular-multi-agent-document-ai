      "split": "benchmark_labeled",
      "label_status": "labeled",
      "intended_use": "Exact regression checks and static vs adaptive benchmark comparisons."
    },
    {
      "split": "synthetic_demo_unlabeled",
      "label_status": "unlabeled",
      "intended_use": "UI demos and schema/route sanity checks."
    },
    {
      "split": "pilot_real_unlabeled",
      "label_status": "unlabeled",
      "intended_use": "Real PDF pilot processing, OCR-path validation, and manual review queue creation."
    }
  ],
